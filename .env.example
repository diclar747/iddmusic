# ===== IDD Music · configuración de producción (copiar a .env y completar) =====
# Generar secretos:  openssl rand -base64 36

# Dominio público (HTTPS). Chromecast y la cámara/pantallas necesitan HTTPS.
DOMAIN=cd.com.py
APP_ORIGIN=https://cd.com.py

# Base de datos (PostgreSQL en el contenedor "db"; no se expone a Internet)
POSTGRES_DB=idd_music
POSTGRES_USER=idd_user
POSTGRES_PASSWORD=CAMBIAR_POR_UNA_CLAVE_LARGA_Y_ALEATORIA

# Sesiones
JWT_SECRET=CAMBIAR_POR_UN_SECRETO_ALEATORIO_DE_AL_MENOS_32_CARACTERES
JWT_EXPIRES_IN=12h

# Archivos
MAX_UPLOAD_MB=25

# Puerto donde queda la web dentro del servidor (el Nginx/Apache del servidor o Caddy apuntan acá)
WEB_BIND=127.0.0.1
WEB_PORT=8080

# Niro IA (transcripción de PDF/imágenes). Generá la key en https://niro.cnid.com.py/api-keys
NIRO_BASE_URL=https://niro.cnid.com.py
NIRO_API_KEY=
